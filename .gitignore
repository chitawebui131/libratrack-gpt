# ##########################################
# 1. Бінарні файли та компіляція
# ##########################################
# Головні виконувані файли (можна вказати конкретні назви, наприклад, /app)
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
out/
dist/

# ##########################################
# 2. Інструменти тестування та покриття
# ##########################################
*.test
*.out
*.prof
# Файли покриття коду (coverage)
coverage.txt
profile.out

# ##########################################
# 3. Керування залежностями
# ##########################################
# Зазвичай vendor/ не додають у git, якщо використовують Go Modules (Go 1.11+)
# Розкоментуйте рядок нижче, якщо НЕ хочете зберігати копії залежностей у репозиторії
# vendor/

# ##########################################
# 4. Локальні змінні оточення (Секрети)
# ##########################################
.env
.env.local
.env.*.local

# ##########################################
# 5. Специфічні файли IDE та операційних систем
# ##########################################
# JetBrains (GoLand / IntelliJ IDEA)
.idea/
*.iws
*.iml

# VS Code
.vscode/
!.vscode/extensions.json

