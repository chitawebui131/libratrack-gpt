      book_id BIGINT NOT NULL REFERENCES books(id) ON DELETE CASCADE,
      author_id BIGINT NOT NULL REFERENCES authors(id) ON DELETE RESTRICT,
      PRIMARY KEY (book_id, author_id)
    );

    CREATE TABLE copies (
      id BIGSERIAL PRIMARY KEY,
      book_id BIGINT NOT NULL REFERENCES books(id) ON DELETE CASCADE,
      inventory_no VARCHAR(50) NOT NULL UNIQUE,
      status VARCHAR(20) NOT NULL DEFAULT 'available' CHECK (status IN 
('available','borrowed','lost','under_repair')),
      created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
      updated_at TIMESTAMPTZ NOT NULL DEFAULT now()
    );

    CREATE TABLE users (
      id BIGSERIAL PRIMARY KEY,
      email VARCHAR(255) NOT NULL UNIQUE,
      password_hash VARCHAR(255) NOT NULL DEFAULT '',
      full_name VARCHAR(255) NOT NULL DEFAULT '',
      role VARCHAR(20) NOT NULL DEFAULT 'reader' CHECK (role IN 
('admin','librarian','reader')),
      created_at TIMESTAMPTZ NOT NULL DEFAULT now()
    );

    CREATE INDEX idx_books_category_id ON books(category_id);
    CREATE INDEX idx_book_authors_author_id ON book_authors(author_id);
    CREATE INDEX idx_copies_book_id ON copies(book_id);
    CREATE INDEX idx_copies_status ON copies(status);
