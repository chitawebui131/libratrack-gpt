func TestUpdateNotFound(t *testing.T) {
    repo := NewInMemoryBookRepository()
    book := &model.Book{
        ID: 999,
        Title: "Nonexistent",
        ISBN: "isbn-non",
        Author: "Author",
        Category: "Fiction",
    }
    if err := repo.Update(book); err == nil {
        t.Fatalf("expected error, got nil")
    } else if !errors.Is(err, ErrNotFound) {
        t.Fatalf("expected ErrNotFound, got %v", err)
    }
}
