+func LoggingMiddleware() gin.HandlerFunc {
+       return func(c *gin.Context) {
+               start := time.Now()
+               c.Next()
+               duration := time.Since(start)
+               log.Printf("%s %s %d %s",
+                       c.Request.Method,
+                       c.Request.URL.Path,
+                       c.Writer.Status(),
+                       duration,
+               )
+       }
